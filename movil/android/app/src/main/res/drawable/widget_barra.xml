<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de cuánto mes ha pasado: carril gris oscuro y relleno dorado -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="3dp"/><solid android:color="#FF2E2E3A"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp"/><solid android:color="#FFFFC93C"/></shape></clip>
    </item>
</layer-list>
